# Firecrawl is the ONLY credential required (for public website enrichment).
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- BizMap SaaS app (Phase 2) ----
# Postgres 18 + PostGIS. Create the role/database yourself (see HANDOFF.md section 3e); never commit the real password.
DATABASE_URL=postgres://bizmap:CHANGE_ME@localhost:5432/bizmap
# Public address of the app (needed for SSLCOMMERZ callbacks/IPN when hosted). Local default: http://localhost:8787
# APP_URL=https://app.example.com
# SSLCOMMERZ: without these, a clearly labelled TEST gateway is used (never in production). Sandbox keys: developer.sslcommerz.com
# SSLC_STORE_ID=
# SSLC_STORE_PASSWORD=
# SSLC_LIVE=1                      # real money; only after going live with SSLCOMMERZ
# Email sending (campaigns, alert digests). Without SMTP_URL every email is CAPTURED in the in-app Outbox (test mode).
# Simplest (e.g. Brevo: SMTP & API → SMTP tab):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-login@smtp-brevo.com
# SMTP_PASS=your-smtp-key
# …or one URL instead (login/key must be URL-encoded, e.g. @ → %40):
# SMTP_URL=smtps://USER:PASSWORD@email-smtp.ap-south-1.amazonaws.com:465   # any SMTP provider (SES, Brevo, Mailgun...)
# MAIL_FROM="BizMap <no-reply@yourdomain.com>"                             # sender for system emails (alerts)
# APP_SECRET=long-random-string    # optional: signs unsubscribe links (otherwise a key is generated and kept in the DB)
# WA_GRAPH_VERSION=v23.0           # Meta Graph API version for WhatsApp; each workspace connects its own number in Settings → Sending
# WORKERS=0                        # disable the campaign/alert background workers on extra API servers
# TRIAL_CREDITS=200                # credits for a new user's first workspace
# ALLOW_SIGNUP=0                   # invite-only sign-up
# BILLING_PACKS=[{"id":"starter","label":"Starter","credits":1000,"bdt":1000}]
# TRUST_PROXY=1                    # only behind a reverse proxy that sets X-Forwarded-For
# NODE_ENV=production              # secure cookies, disables the test gateway

# Optional overrides (sensible defaults are built in)
# OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
# NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org
# CONTACT_EMAIL=you@example.com   # sent in User-Agent per OSM usage policy
